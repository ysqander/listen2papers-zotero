{
  "manifest_version": 2,
  "name": "listen2papers for Zotero",
  "version": "0.1.0",
  "description": "Send selected Zotero PDFs to listen2papers.",
  "homepage_url": "https://listen2papers.com/zotero",
  "applications": {
    "zotero": {
      "id": "listen2papers@listen2papers.com",
      "strict_min_version": "7.0",
